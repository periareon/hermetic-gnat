# Pins shared by every GCC version.  Loaded before versions/<gcc>.env, which
# may override any of these.
#
# Everything here is a property of *how* the toolchains are built (the
# compatibility floors, the prerequisites linked into the compiler), not of
# which GCC is built.  A change here is a recipe change: cut a new
# hermetic-gnat release, which rebuilds every GCC version with it.

# ---------------------------------------------------------------------------
# GCC prerequisites (all linked statically into the compiler)
# ---------------------------------------------------------------------------
GMP_VERSION=6.3.0
GMP_URL=https://gcc.gnu.org/pub/gcc/infrastructure/gmp-${GMP_VERSION}.tar.bz2
GMP_SHA256=ac28211a7cfb609bae2e2c8d6058d66c8fe96434f740cf6fe2e47b000d1c20cb

MPFR_VERSION=4.2.2
MPFR_URL=https://gcc.gnu.org/pub/gcc/infrastructure/mpfr-${MPFR_VERSION}.tar.bz2
MPFR_SHA256=9ad62c7dc910303cd384ff8f1f4767a655124980bb6d8650fe62c815a231bb7b

MPC_VERSION=1.3.1
MPC_URL=https://gcc.gnu.org/pub/gcc/infrastructure/mpc-${MPC_VERSION}.tar.gz
MPC_SHA256=ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8

# The version GCC's own contrib/download_prerequisites uses, from the same
# gcc.gnu.org mirror as the others (libisl.sourceforge.io intermittently
# answers 403).  sha512 cross-checked against contrib/prerequisites.sha512.
ISL_VERSION=0.24
ISL_URL=https://gcc.gnu.org/pub/gcc/infrastructure/isl-${ISL_VERSION}.tar.bz2
ISL_SHA256=fcf78dd9656c10eb8cf9fbd5f59a0b6b01386205fe1934b3b287a0a1898145c0

# ---------------------------------------------------------------------------
# binutils (Linux and Windows; macOS uses Apple's assembler and linker)
# ---------------------------------------------------------------------------
BINUTILS_VERSION=2.46.1
BINUTILS_URL=https://ftp.gnu.org/gnu/binutils/binutils-${BINUTILS_VERSION}.tar.xz
BINUTILS_SHA256=e127a709cba24c76de8936cb7083dd768f28cd37eb010492e2f19b71eb1294e4

# ---------------------------------------------------------------------------
# mingw-w64 headers + CRT (Windows only)
# ---------------------------------------------------------------------------
MINGW_VERSION=14.0.0
MINGW_URL=https://download.sourceforge.net/project/mingw-w64/mingw-w64/mingw-w64-release/mingw-w64-v${MINGW_VERSION}.tar.bz2
MINGW_SHA256=6eaf921d9eb987d3820b364ea9775bc19b965ec81490b6fdd716526c28e1995c
# Oldest Windows the produced binaries target (0x0601 = Windows 7).
MINGW_WINNT=0x0601

# ---------------------------------------------------------------------------
# Bootstrap compilers for macOS and Windows come from GNAT-FSF-builds; the
# archive version and checksums are per GCC version (a bootstrap of the same
# major is used, as GNAT-FSF-builds itself does).  Linux bootstraps from the
# GNAT in the container below and then rebuilds itself twice (3-stage
# bootstrap), so nothing of it survives in the shipped toolchain.
# ---------------------------------------------------------------------------
BOOTSTRAP_BASE_URL=https://github.com/alire-project/GNAT-FSF-builds/releases/download/gnat-${BOOTSTRAP_GNAT_VERSION}

# ---------------------------------------------------------------------------
# Linux build container.  Debian 10 "buster": glibc 2.28, gnat-8 (GCC only
# needs a GNAT >= 5.4 to bootstrap).  The manifest-list digest covers both
# amd64 and arm64.
# ---------------------------------------------------------------------------
LINUX_CONTAINER=docker.io/library/debian@sha256:58ce6f1271ae1c8a2006ff7d3e54e9874d839f573d8009c20154ad0f2fb0a225
# Highest glibc symbol version any shipped executable may reference.
# Enforced by scripts/check.sh.
LINUX_GLIBC_FLOOR=2.28

# ---------------------------------------------------------------------------
# macOS: applies to the compiler executables and to the runtime libraries
# they ship.  11.0 covers every Apple Silicon Mac and every Intel Mac from
# 2013 on.
# ---------------------------------------------------------------------------
MACOS_DEPLOYMENT_TARGET=11.0

# ---------------------------------------------------------------------------
# Build flags: host-side optimisation for the bootstrap stages.  Debug info
# is dropped because everything is install-stripped anyway.
# ---------------------------------------------------------------------------
GCC_STAGE1_CFLAGS="-O2 -g0"
GCC_BOOT_CFLAGS="-O2 -g0"
