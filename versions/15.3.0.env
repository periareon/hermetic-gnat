# GCC 15.3.0.  Loaded after versions/common.env.
#
# Every hermetic-gnat release builds this version (archive
# gnat-<arch>-<os>-15.3.0.tar.gz); the release tag identifies the recipe.

GCC_VERSION=15.3.0

GCC_URL=https://gcc.gnu.org/pub/gcc/releases/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz
GCC_SHA256=fa59c1beef8995f27c4d71c1df227587189315d3e6faff1bb4306e61b0c530eb

GCC_DARWIN_TAG=gcc-15.3-darwin-r0
GCC_DARWIN_URL=https://github.com/iains/gcc-15-branch/archive/refs/tags/${GCC_DARWIN_TAG}.tar.gz
GCC_DARWIN_SHA256=053b28e8f6eedc4fe9c1f82523a8a80b329145a9a6eba108e072f3617f698011
GCC_DARWIN_SRCDIR=gcc-15-branch-${GCC_DARWIN_TAG}

# Bootstrap GNAT (macOS, Windows): GNAT-FSF-builds archives of the same major.
BOOTSTRAP_GNAT_VERSION=15.3.0-1
BOOTSTRAP_SHA256_darwin_x86_64=99f5ac7740fcc97587741d8ab17b25b3e0ce9229774e9f7788c3c1e3cedcc1b6
BOOTSTRAP_SHA256_darwin_aarch64=36dc731443de2b8fb00aa0a40edcb06369c6e677912ad3f045f98e1121276627
BOOTSTRAP_SHA256_windows_x86_64=ebcc01066d1ebd319037bdd0f5bf6c068055b2c86f60945ed7e9c8cf96fd0dbb
