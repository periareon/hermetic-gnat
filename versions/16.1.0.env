# GCC 16.1.0.  Loaded after versions/common.env.
#
# Every hermetic-gnat release builds this version (archive
# gnat-<arch>-<os>-16.1.0.tar.gz); the release tag identifies the recipe.

GCC_VERSION=16.1.0

GCC_URL=https://gcc.gnu.org/pub/gcc/releases/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz
GCC_SHA256=50efb4d94c3397aff3b0d61a5abd748b4dd31d9d3f2ab7be05b171d36a510f79

# Iain Sandoe's Darwin branch: carries the Apple Silicon / modern-Xcode fixes
# that are not all in the FSF release.  Same source GNAT-FSF-builds uses.
GCC_DARWIN_TAG=gcc-16.1-darwin-r0
GCC_DARWIN_URL=https://github.com/iains/gcc-16-branch/archive/refs/tags/${GCC_DARWIN_TAG}.tar.gz
GCC_DARWIN_SHA256=0c8f5c8acef29e039cd959b18a6b0617e0c9b5af56a92b958962d76232f47aeb
GCC_DARWIN_SRCDIR=gcc-16-branch-${GCC_DARWIN_TAG}

# Bootstrap GNAT (macOS, Windows): GNAT-FSF-builds archives of the same major.
BOOTSTRAP_GNAT_VERSION=16.1.0-1
BOOTSTRAP_SHA256_darwin_x86_64=bb6d1434dc8850d7c6523eb455ab27f1f94eb760222c6c8acd540631e3f629bb
BOOTSTRAP_SHA256_darwin_aarch64=657cf254323eb91f79768918e8bd8887d6da7ac6056732a38f21e2848267da18
BOOTSTRAP_SHA256_windows_x86_64=bbd696339184ec0301fad1ec6170e8eedb03b83665e2bb3a52571d5fbf064cf9
