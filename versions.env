# Single source of truth for everything that is pinned in a build.
#
# This file is sourced by bash (scripts/lib/common.sh) and parsed by the
# GitHub workflows (scripts/env.sh).  Keep it to simple KEY=VALUE lines;
# later values may reference earlier ones with ${...}.
#
# Bumping GCC:
#   1. Update GCC_VERSION / GCC_SHA256 (https://gcc.gnu.org/pub/gcc/releases/).
#   2. Update GCC_DARWIN_TAG / GCC_DARWIN_SHA256 to the matching tag of
#      https://github.com/iains/gcc-16-branch (or the next major's branch).
#      macOS builds come from that fork, exactly like GNAT-FSF-builds.
#   3. Pick bootstrap GNAT archives (BOOTSTRAP_*) that are at most one major
#      version behind GCC_VERSION.
#   4. Reset PKG_RELEASE to 1.
#
# The release tag is always gnat-${GCC_VERSION}-${PKG_RELEASE}.

GCC_VERSION=16.1.0
PKG_RELEASE=1

# ---------------------------------------------------------------------------
# GCC sources
# ---------------------------------------------------------------------------
GCC_URL=https://gcc.gnu.org/pub/gcc/releases/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz
GCC_SHA256=50efb4d94c3397aff3b0d61a5abd748b4dd31d9d3f2ab7be05b171d36a510f79

# Iain Sandoe's Darwin branch: carries the Apple Silicon / modern-Xcode fixes
# that are not all in the FSF release.  Same source GNAT-FSF-builds uses.
GCC_DARWIN_TAG=gcc-16.1-darwin-r0
GCC_DARWIN_URL=https://github.com/iains/gcc-16-branch/archive/refs/tags/${GCC_DARWIN_TAG}.tar.gz
GCC_DARWIN_SHA256=0c8f5c8acef29e039cd959b18a6b0617e0c9b5af56a92b958962d76232f47aeb
# Directory name inside the GitHub-generated tarball.
GCC_DARWIN_SRCDIR=gcc-16-branch-${GCC_DARWIN_TAG}

# ---------------------------------------------------------------------------
# GCC prerequisites (all linked statically into the compiler)
# ---------------------------------------------------------------------------
GMP_VERSION=6.3.0
GMP_URL=https://gcc.gnu.org/pub/gcc/infrastructure/gmp-${GMP_VERSION}.tar.bz2
GMP_SHA256=ac28211a7cfb609bae2e2c8d6058d66c8fe96434f740cf6fe2e47b000d1c20cb

MPFR_VERSION=4.2.2
MPFR_URL=https://gcc.gnu.org/pub/gcc/infrastructure/mpfr-${MPFR_VERSION}.tar.bz2
MPFR_SHA256=9ad62c7dc910303cd384ff8f1f4767a655124980bb6d8650fe62c815a231bb7b

MPC_VERSION=1.3.1
MPC_URL=https://gcc.gnu.org/pub/gcc/infrastructure/mpc-${MPC_VERSION}.tar.gz
MPC_SHA256=ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8

ISL_VERSION=0.27
ISL_URL=https://libisl.sourceforge.io/isl-${ISL_VERSION}.tar.bz2
ISL_SHA256=626335529331f7c89fec493de929e2e92fb3d8cc860fc7af554e0518ee0029ee

# ---------------------------------------------------------------------------
# binutils (Linux and Windows; macOS uses Apple's assembler and linker)
# ---------------------------------------------------------------------------
BINUTILS_VERSION=2.46.1
BINUTILS_URL=https://ftp.gnu.org/gnu/binutils/binutils-${BINUTILS_VERSION}.tar.xz
BINUTILS_SHA256=e127a709cba24c76de8936cb7083dd768f28cd37eb010492e2f19b71eb1294e4

# ---------------------------------------------------------------------------
# mingw-w64 headers + CRT (Windows only)
# ---------------------------------------------------------------------------
MINGW_VERSION=14.0.0
MINGW_URL=https://download.sourceforge.net/project/mingw-w64/mingw-w64/mingw-w64-release/mingw-w64-v${MINGW_VERSION}.tar.bz2
MINGW_SHA256=6eaf921d9eb987d3820b364ea9775bc19b965ec81490b6fdd716526c28e1995c
# Oldest Windows the produced binaries target (0x0601 = Windows 7).
MINGW_WINNT=0x0601

# ---------------------------------------------------------------------------
# Bootstrap compilers.  GNAT is written in Ada, so a GNAT is needed to build
# one.  macOS and Windows bootstrap from pinned GNAT-FSF-builds archives.
# Linux bootstraps from the GNAT shipped by the pinned container image below
# (GCC 16 only requires GNAT >= 5.4) and then rebuilds itself twice more
# (standard 3-stage bootstrap), so nothing of the bootstrap compiler survives
# in the shipped toolchain.
# ---------------------------------------------------------------------------
BOOTSTRAP_GNAT_VERSION=16.1.0-1
BOOTSTRAP_BASE_URL=https://github.com/alire-project/GNAT-FSF-builds/releases/download/gnat-${BOOTSTRAP_GNAT_VERSION}
BOOTSTRAP_SHA256_darwin_x86_64=bb6d1434dc8850d7c6523eb455ab27f1f94eb760222c6c8acd540631e3f629bb
BOOTSTRAP_SHA256_darwin_aarch64=657cf254323eb91f79768918e8bd8887d6da7ac6056732a38f21e2848267da18
BOOTSTRAP_SHA256_windows_x86_64=bbd696339184ec0301fad1ec6170e8eedb03b83665e2bb3a52571d5fbf064cf9

# ---------------------------------------------------------------------------
# Linux build container.  Debian 10 "buster": glibc 2.28, gnat-8.
# The manifest-list digest covers both amd64 and arm64.
# ---------------------------------------------------------------------------
LINUX_CONTAINER=docker.io/library/debian@sha256:58ce6f1271ae1c8a2006ff7d3e54e9874d839f573d8009c20154ad0f2fb0a225
# Highest glibc symbol version any shipped executable may reference.
# Enforced by scripts/check.sh.
LINUX_GLIBC_FLOOR=2.28

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
# Applies to the compiler executables and to the runtime libraries they ship.
# 11.0 covers every Apple Silicon Mac and every Intel Mac from 2013 on.
MACOS_DEPLOYMENT_TARGET=11.0

# ---------------------------------------------------------------------------
# Build flags
# ---------------------------------------------------------------------------
# Host-side optimisation flags for the bootstrap stages.  Debug info is
# dropped because everything is install-stripped anyway.
GCC_STAGE1_CFLAGS="-O2 -g0"
GCC_BOOT_CFLAGS="-O2 -g0"
